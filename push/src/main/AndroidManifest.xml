<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.walle.push">

    <application>
        <activity android:name=".sdkHuawei.HuaweiActivity">

        </activity>

        <activity android:name="com.walle.push.sdkHuawei.Deeplink2Activity">
            <intent-filter>
                <action android:name="com.huawei.codelabpush.intent.action.test" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="push_kit_auto_init_enabled"
            android:value="false" />

        <activity android:name="com.walle.push.sdkHuawei.DeeplinkActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="com.huawei.codelabpush"
                    android:path="/deeplink"
                    android:scheme="pushscheme" />
            </intent-filter>
        </activity>

        <service
            android:name="com.walle.push.sdkHuawei.MyPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.huawei.push.action.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
[Unit]
Description=RaspberryPi System Monitor over MQTT
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gs
# 模板：部署时把用户 / 安装目录替换成实际值（命令见 linux/README.md 3.3）
WorkingDirectory=/home/gs/mqtt_demo
EnvironmentFile=-/etc/rpi-monitor.env
ExecStart=/home/gs/mqtt_demo/.venv/bin/python /home/gs/mqtt_demo/rpi_monitor.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

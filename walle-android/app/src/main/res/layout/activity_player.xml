<?xml version="1.0" encoding="utf-8"?>
<!--
  播放页布局。

  设计要点：
  1. 根布局背景为白色。视频使用 SurfaceViewRenderer 的 SCALE_ASPECT_FIT
     等比例缩放（不裁剪），当视频宽高比与横屏屏幕不一致时，画面上下或左右
     会露出未覆盖区域，这些区域显示根布局的白色。
  2. SurfaceViewRenderer 宽高均为 0dp 并四边约束到父布局，表示「占满整个
     父容器」；真正的等比例缩放由渲染器内部根据视频分辨率完成。
  3. 所有悬浮控件（返回、摄像头切换、状态条、麦克风）都共用同一份视觉参数：
     bg_overlay_scrim（半透黑 8dp 圆角）+ white + textSize=14sp + padding 12/8dp，
     并把它们放在同一个水平 LinearLayout 里，靠 gravity=center_vertical 对齐中线。
     Spinner 的触发器外观由 item_spinner_camera_selected_dark 控制，背景再叠加
     bg_overlay_scrim 做统一外壳。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remoteRenderer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/firstFrameMask"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/screen_bg_top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
      顶部悬浮控制条：返回、连接状态、摄像头切换、麦克风放在同一行。
      四个控件自身高度不同（Spinner 比 TextView 矮），由 LinearLayout 的
      gravity=center_vertical 统一按中线对齐；行内 Space 权重把右侧控件顶到屏幕右端。
    -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 返回按钮 -->
        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_overlay_scrim"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="@string/back"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <!-- 连接状态条：文本动态变化，超长时省略，避免把右侧控件挤出屏幕 -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_overlay_scrim"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="正在连接…"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <!-- 左右两组之间的弹簧 -->
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 右上角摄像头切换 Spinner -->
        <Spinner
            android:id="@+id/spinnerCamera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_overlay_scrim"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:popupBackground="@drawable/bg_popup_dark"
            android:dropDownVerticalOffset="6dp" />

        <!-- 麦克风开关（反向音频：手机 → 设备端），默认关闭 -->
        <TextView
            android:id="@+id/micButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_overlay_scrim"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="@string/mic_off"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- 摄像头选择 + 视频区域：整体一张卡片 -->
    <LinearLayout
        android:id="@+id/cardControl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/video_camera_label"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spinnerCamera"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:minHeight="40dp"
                android:popupBackground="@drawable/bg_popup_dark" />
        </LinearLayout>

        <!-- 音频外设能力（capability/result 的 audio 分组）：麦克风 / 音响 -->
        <TextView
            android:id="@+id/tvAudioInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 视频区域：16:9 比例，由 AspectRatioFrameLayout 在测量阶段固定 -->
        <www.walle.ai.ui.AspectRatioFrameLayout
            android:id="@+id/flVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_dashed_placeholder"
            android:clickable="true"
            android:focusable="true">

            <org.webrtc.SurfaceViewRenderer
                android:id="@+id/videoRenderer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ProgressBar
                android:id="@+id/pbVideo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/btnPlay"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_play_button"
                android:contentDescription="@string/video_tap_to_play"
                android:padding="18dp"
                android:src="@drawable/ic_play" />

            <!-- 视频流显示时的放大按钮：跳转 PlayerActivity 全屏观看 -->
            <ImageView
                android:id="@+id/ivFullscreen"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/bg_icon_scrim"
                android:contentDescription="@string/video_fullscreen"
                android:padding="8dp"
                android:src="@drawable/ic_fullscreen"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvVideoStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_overlay_scrim"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/video_tap_to_play"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </www.walle.ai.ui.AspectRatioFrameLayout>
    </LinearLayout>
</LinearLayout>

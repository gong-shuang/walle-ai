# 推流控制请求（net_mqtt_bridge -> video_webrtc_bridge）
bool start                 # true=开始推流，false=停止推流
string video_device        # 已废弃：start 由设备端使用默认摄像头，忽略此字段
string room_number         # start 由设备端自动生成；stop 可空（空=停止当前推流）

---
# 应答
int32 result               # 0 成功（含已在推流）/ -1 没有此摄像头设备或当前无流 / -2 命令执行失败
string cause               # ok / 没有此摄像头设备 / 当前没有设备在推流 / 命令执行失败
string action              # started / already_streaming / failed / stopped
bool stopped               # stop：是否真的停了一路流
string video_device        # start：实际使用的默认摄像头
string room_number         # start：设备端生成的房间号
int32 pid
string rtmp_url            # 已脱敏，可直接回给 App
string command             # 已脱敏的 ffmpeg 命令行
string started_at
float64 started_ts
string error
bool audio_available
string audio_device
string audio_codec
string audio_bitrate
string audio_reason

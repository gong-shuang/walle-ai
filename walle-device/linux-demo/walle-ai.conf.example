# linux-demo 设备端配置模板
#
# 开发环境：
#   cp walle-ai.conf.example walle-ai.conf
#   vi walle-ai.conf
#   python3 main.py            # 自动读取脚本同级的 walle-ai.conf
#
# 生产环境：
#   sudo install -m 600 -o root -g root walle-ai.conf /etc/walle-ai.conf
#   systemd 通过 EnvironmentFile=/etc/walle-ai.conf 注入
#
# 真实配置已被 .gitignore 忽略，不要提交到仓库。

# ---- 运行环境（prod/debug）----
# prod：强制 MQTT TLS；debug：允许 MQTT_TLS=off，仅用于本地联调
WALLE_RUNTIME_ENV=prod

# ---- MQTT（必填）----
MQTT_HOST=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TENANT=
# 生产环境只接受 on；off 仅在 WALLE_RUNTIME_ENV=debug 下允许
MQTT_TLS=on
# 自签 CA 路径；留空使用系统 CA
MQTT_CA_FILE=

# ---- WebRTC / 推流（VIDEO_ENABLE / PHONE_AUDIO_ENABLE 默认 true，对应配置必填）----
WHIP_SECRET=
# 视频推流地址模板；{room}/{secret} 由设备填充
VIDEO_RTMP_URL_TEMPLATE=rtmp://your-server:1935/live/{room}?secret={secret}
# 可选：固定摄像头设备（udev 符号链接，如 /dev/walle-camera）；留空接受任意 /dev/videoN
# CAMERA_DEVICE=/dev/walle-camera
# 手机麦上行 WHEP 地址模板（经 Nginx secure_link 鉴权，见 ../../../doc/service_deploy.md §6.2）
# {stream}/{expires}/{token} 由设备填充
PHONE_AUDIO_WHEP_URL_TEMPLATE=https://your-server:8443/whep-audio/?app=live&stream={stream}&expires={expires}&token={token}
# 与 Nginx secure_link 的 secret 一致；不要复用 WHIP_SECRET
PHONE_AUDIO_WHEP_SECRET=
# 与 Nginx location 路径一致；改路径需同时改 Nginx 与设备
# PHONE_AUDIO_WHEP_PATH=/whep-audio/
# token 有效期（秒）
# PHONE_AUDIO_WHEP_TOKEN_TTL=300

# 可选能力开关：不需要对应能力时置 false，可免配置上面的模板
# VIDEO_ENABLE=true
# PHONE_AUDIO_ENABLE=true

# ---- 可选：流租约与断连回收（秒，0=不限制）----
# 推流/手机音频达到最长时长后自动停止并告警，避免 App 崩溃后一直占用摄像头/声卡
# VIDEO_MAX_DURATION_SEC=1800
# PHONE_AUDIO_MAX_DURATION_SEC=1800
# 推流参数：分辨率不传时按摄像头能力自动选择（优先 VIDEO_VIDEO_SIZE）
# VIDEO_VIDEO_SIZE=640x480
# VIDEO_FRAMERATE=30
# VIDEO_BITRATE=1000k
# VIDEO_GOP=60
# 编码器：auto（有硬件编码器优先 h264_v4l2m2m，否则 libx264）/ libx264 / h264_v4l2m2m
# VIDEO_ENCODER=auto
# VIDEO_PRESET=ultrafast
# VIDEO_TUNE=zerolatency
# 手机音频超过该秒数没有收到音频帧时退出播放器（退出码 7）
# PHONE_AUDIO_IDLE_TIMEOUT=30
# MQTT 断连超过该秒数后停止推流/手机音频
# MQTT_DISCONNECT_STOP_SEC=60

# ---- 可选：推流日志保留（每次新建日志前清理最旧文件；0=不限制）----
# 日志目录：留空 = main.py 所在目录；相对路径以此为基准，绝对路径原样使用
# 注意：若指向安装目录之外，systemd 模板的 ReadWritePaths 需要同步追加该目录
# WALLE_LOG_DIR=/var/log/walle-ai
# VIDEO_LOG_KEEP_DAYS=7
# VIDEO_LOG_KEEP_FILES=10
# VIDEO_LOG_MAX_TOTAL_MB=100

# ---- 可选：请求池与能力缓存 ----
# QUERY_WORKERS=2
# ACTION_WORKERS=2
# QUERY_QUEUE_LIMIT=16
# ACTION_QUEUE_LIMIT=4
# CAPABILITY_CACHE_TTL=120
# CAPABILITY_FIRST_WAIT=3
# CAPABILITY_CACHE_ONLY=false

# ---- 可选：监控阈值 ----
# MONITOR_INTERVAL=5
# THRESH_CPU=90.0
# THRESH_MEM=90.0
# THRESH_DISK=90.0
# THRESH_TEMP=80.0
# THRESH_NET_MIB=10

# ---- 可选：设备标识文件 ----
# 生产默认由 deploy.sh 安装到 /var/lib/walle-ai/device-id；
# 显式配置会覆盖该默认值（需同步 systemd ReadWritePaths）
# DEVICE_ID_FILE=/var/lib/walle-ai/device-id

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>net_mqtt_bridge</name>
  <version>0.1.0</version>
  <description>MQTT protocol bridge for Walle: MQTT topics to ROS2 services and system status.</description>
  <maintainer email="gs@example.com">gs</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>interfaces</exec_depend>
  <exec_depend>python3-psutil</exec_depend>
  <exec_depend>python3-paho-mqtt</exec_depend>
  <exec_depend>v4l-utils</exec_depend>
  <exec_depend>ffmpeg</exec_depend>
  <exec_depend>pulseaudio-utils</exec_depend>
  <exec_depend>libportaudio2</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

# 改完执行：sudo systemctl restart walle-ai

# =========== 必填（阿里云 API 密钥） ===========
ALIYUN_API_KEY=sk-你的新key


# ================= 必填（首次部署时必须设置）=================
# MQTT Broker 地址
MQTT_HOST=www.baidong.xyz
# 端口：8883 = TLS（推荐），1883 = 明文
MQTT_PORT=8883
# 设备自己的 MQTT 账号（不是手机账号）
MQTT_USERNAME=RaspPi5
MQTT_PASSWORD=xxxx
# 租户 = 手机 App 登录用的用户名（必须完全一致，否则 App 收不到本设备）
MQTT_TENANT=home
# Oryx 推流鉴权 secret（Oryx 控制台「推流鉴权」生成，每台服务器不同；重置后需同步更新 App 与设备）
WHIP_SECRET=xxxxx

# ================= 可选 =================
# TLS：auto 时 8883/8084 自动启用；on/off 可强制
MQTT_TLS=on
# 自签 CA 路径；留空使用系统 CA
MQTT_CA_FILE=

# 监控阈值（按需改）
# MONITOR_INTERVAL=5
# THRESH_MEM=90.0
# THRESH_DISK=90.0
# THRESH_TEMP=80.0

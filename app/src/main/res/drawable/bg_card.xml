<?xml version="1.0" encoding="utf-8"?>
<!-- 玻璃卡片：深蓝渐变 + 1dp 冷色描边 + 14dp 圆角，深色主题下的统一卡片容器 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/card_bg"
        android:endColor="@color/card_bg_alt"
        android:type="linear" />
    <corners android:radius="14dp" />
    <stroke
        android:width="1dp"
        android:color="@color/card_stroke" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- connectedDevice：MQTT 长连接的正解，不受 Android 15 的 dataSync 6h/天 配额限制。
         该类型在 Android 14+ 要求应用持有 CHANGE_NETWORK_STATE 之一的前置权限（普通权限，安装即得）。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- dataSync 仅作为兜底：个别厂商 ROM 若不认 connectedDevice，代码会回退到它 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        不做云备份/整机迁移：本 App 没有值得备份的用户数据（告警在内存、配置是设备相关），
        而备份会把 broker 地址与加密凭据一起带走；换机重新输入凭据更安全也更简单。
        凭据本身已用 Android Keystore 加密，换机后旧密文本来也无法解密。
    -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.RPiMqtt">

        <!--
            竖屏约定：除播放页外，所有页面固定竖屏（手机横放时界面不变）。
            播放页 PlayerActivity 是唯一的横屏例外 —— 视频全屏观看，随重力在左右横屏间切换。
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 首次启动引导页：全屏沉浸式，3 屏图片横滑 -->
        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.RPiMqtt.Onboarding" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/server_settings_title"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.AlarmActivity"
            android:exported="false"
            android:label="@string/alarm_title"
            android:screenOrientation="portrait"
            android:parentActivityName=".ui.MainActivity" />

        <!-- 播放页：横屏例外，sensorLandscape 允许左右横屏随重力切换 -->
        <activity
            android:name=".ui.PlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="sensorLandscape"
            android:supportsPictureInPicture="false" />

        <service
            android:name=".net.MqttService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|dataSync" />

    </application>
</manifest>

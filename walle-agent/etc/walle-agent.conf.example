# walle-agent 配置（由 scripts/auto_gen_conf_service.sh 生成）
# MQTT 连接
MQTT_HOST=
MQTT_PORT=8883
MQTT_TLS=1
MQTT_USER=
MQTT_PASSWORD=

# 租户与 agent 身份：默认与 MQTT 用户名一致；独立多租户部署时可分别修改
TENANT=
CHAT_MQTT_ENABLED=1
CLIENT_ID_PREFIX=agent-

# 运动限制与发送频率
DEFAULT_SPEED=0.5
MIN_SPEED=0.5
MAX_SPEED=0.6
MAX_DISTANCE=10
DEFAULT_ANGULAR=1.0
MAX_ANGLE=360
SEND_HZ=5

# 复杂语句走 LLM（默认关闭）
LLM_ENABLED=0
# 路由：off/local/online/hybrid；hybrid=简单先本地、复杂先在线，失败互相回退
LLM_MODE=local
# 通用 OpenAI 兼容配置（本地未单独配置时复用）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# M4-03 本地模型：Ollama 填 http://127.0.0.1:11434/v1，vLLM 填 http://127.0.0.1:8000/v1
LLM_LOCAL_BASE_URL=
LLM_LOCAL_API_KEY=
LLM_LOCAL_MODEL=
# 本地模型思考模式：1=开启，0=关闭（Qwen3/3.6 + OMLX/Ollama 可关；不支持该参数的模型保持 1）
LLM_LOCAL_THINKING_MODE=1
# 超时与重试（秒）
LLM_TIMEOUT_SEC=8
LLM_RETRY_MAX=1
LLM_RETRY_BACKOFF_SEC=0.5
# M4-04 在线模型：DeepSeek/Qwen 等 OpenAI 兼容；Key 只读配置，不写日志
LLM_ONLINE_BASE_URL=
LLM_ONLINE_API_KEY=
LLM_ONLINE_MODEL=
# 熔断：连续传输失败 N 次后暂停 cooldown 秒
LLM_CIRCUIT_FAILS=3
LLM_CIRCUIT_COOLDOWN_SEC=60
# M4-06 多轮会话：最近 N 轮 + 超时清理（秒）
CHAT_HISTORY_MAX_TURNS=8
CHAT_HISTORY_TTL_SEC=1800

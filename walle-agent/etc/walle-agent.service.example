[Unit]
Description=walle-agent (MQTT car control agent)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/01_code/walle-agent
EnvironmentFile=/home/ubuntu/01_code/walle-agent/etc/walle-agent.conf
ExecStart=/usr/bin/python3 /home/ubuntu/01_code/walle-agent/src/car_agent.py
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
